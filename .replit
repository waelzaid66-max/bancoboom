modules = ["nodejs-20", "python-3.12", "web", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["bash", "scripts/replit-prod-start.sh"]
build = ["bash", "scripts/replit-prod-build.sh"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web App"

[[workflows.workflow]]
name = "Web App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 pnpm --filter @workspace/banco-web run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0", "javascript_object_storage:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 600000

[[ports]]
localPort = 3000
externalPort = 6800

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 8082

[[ports]]
localPort = 8083
externalPort = 5173

[[ports]]
localPort = 8084
externalPort = 6000

[[ports]]
localPort = 18150
externalPort = 4200

[[ports]]
localPort = 21539
externalPort = 3000

[[ports]]
localPort = 22357
externalPort = 8008

[[ports]]
localPort = 23351
externalPort = 8000

[nix]
channel = "stable-25_05"
packages = ["psmisc"]

[objectStorage]
defaultBucketID = "replit-objstore-41fc812e-9f5e-42cb-93cc-f15445fe1efa"

[userenv]

[userenv.shared]
ADMIN_EMAILS = "bancotoday@gmail.com,wael_zeed@yahoo.com"
PAYMOB_MODE = "live"
NEXT_PUBLIC_API_URL = "http://localhost:8080"
NEXT_PUBLIC_SEARCH_ENABLED = "true"
NEXT_PUBLIC_WEB_SEARCH_LIVE = "true"
NEXT_PUBLIC_WEB_SEARCH_MAP = "false"
NEXT_PUBLIC_SEARCH_ANALYTICS_MODE = "off"
CORS_ALLOWED_ORIGINS = "https://banco.today,https://banco.deals,https://banco.autos"
PUBLIC_APP_URL = "https://banco.today"
PUBLIC_API_BASE_URL = "https://banco.today/"
EXPO_PUBLIC_PUBLIC_APP_URL = "https://banco.today"
OPENAI_MODEL = "gpt-4o-mini"
OPENAI_MAX_COMPLETION_TOKENS = "4096"
CLERK_TELEMETRY_DISABLED = "true"
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY = "pk_live_Y2xlcmsuYmFuY28udG9kYXkk"
EXPO_PUBLIC_DOMAIN = "banco.today"

[userenv.development]
